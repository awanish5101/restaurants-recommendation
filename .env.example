# Copy this file to `.env` and fill in real values.
# `.env` is gitignored — NEVER commit real secrets.

# --- Gemini (Google AI Studio) ---
# Create a key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash:generateContent

# --- MongoDB (legacy; removed after the Postgres+pgvector migration) ---
MONGODB_URI=mongodb://localhost:27017/restaurantdb
MONGODB_DATABASE=restaurantdb

# --- Postgres + pgvector (used from Phase 3 onward) ---
# For docker-compose these default to the bundled db service.
# SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/restaurantdb
# SPRING_DATASOURCE_USERNAME=restaurant
# SPRING_DATASOURCE_PASSWORD=restaurant
